{
  "name": "@ss-billing/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "migration:run": "typeorm migration:run -d src/db/data-source.ts",
    "migration:generate": "typeorm migration:generate -d src/db/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.3.10",
    "@nestjs/core": "10.3.10",
    "@nestjs/config": "3.2.3",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.3.10",
    "@nestjs/schedule": "4.1.0",
    "@nestjs/swagger": "7.4.0",
    "@nestjs/typeorm": "10.0.2",
    "@stellar/stellar-sdk": "12.3.0",
    "axios": "1.7.2",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "crypto": "1.0.1",
    "ioredis": "5.4.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.3.10",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "@types/passport-jwt": "4.0.1",
    "@types/uuid": "10.0.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.2",
    "typescript": "5.4.5"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
