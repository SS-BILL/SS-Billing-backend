##############################################################################
# SS-Billing API — environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# Every variable below is read either by `src/config/env.validation.ts`
# (enforced at boot, fail-fast) or by `src/config/index.ts` (runtime accessors).
# The process REFUSES TO START if a required variable is missing or malformed —
# see `validateEnv()`. That is deliberate: a misconfigured billing service that
# boots is worse than one that does not.
#
# NEVER commit a filled-in `.env`. It is already in `.gitignore`.
##############################################################################


# =============================================================================
# Runtime
# =============================================================================

# Optional. Default: unset (treated as non-production).
# Must be the exact string `production` to enable production mode. Anything else
# (including `prod` or `Production`) leaves the app in development mode, which:
#   - mounts Swagger UI at /docs (full API surface disclosure),
#   - enables verbose debug/verbose logging,
#   - allows all CORS origins when CORS_ORIGINS is empty,
#   - skips the CORS_ORIGINS requirement.
# Setting it to `development` additionally turns on SQL query logging.
NODE_ENV=development

# Optional. Default: 3001.
# HTTP listen port. All routes are served under the global prefix `/api/v1`.
# Must match the container's exposed port and any load-balancer target.
PORT=3001


# =============================================================================
# Database (PostgreSQL) — REQUIRED
# =============================================================================

# REQUIRED. Boot fails with "DATABASE_URL is required" if missing or blank.
# Also read directly by the TypeORM CLI (`src/db/data-source.ts`) for
# migrations; migration commands throw immediately without it.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# In production, include `sslmode=require` — validateEnv() logs a warning if
# `sslmode=` is absent, meaning the connection may carry billing data and
# credentials in the clear.
DATABASE_URL=postgres://ssbilling:replace-me-with-a-real-password@localhost:5432/ssbilling

# Optional. Default: 10.
# Maximum PostgreSQL connections in the pool. Do NOT set this to 1: the billing
# keeper holds advisory locks while running its own queries and a single-
# connection pool deadlocks it against itself. Too high and you exhaust the
# server's `max_connections` across replicas.
DATABASE_POOL_MAX=10


# =============================================================================
# Authentication — REQUIRED
# =============================================================================

# REQUIRED. Boot fails if missing, blank, shorter than 32 characters, or equal
# to a known placeholder (`change-me`, `changeme`, `secret`, `jwt-secret`,
# `development`, `test` — case-insensitive).
# This key signs every access token. A weak or leaked value lets anyone forge a
# token for any merchant and read or mutate their billing data.
#
# Generate one:    openssl rand -hex 32
#
# Rotate immediately if it has ever been committed, logged, or shared.
JWT_SECRET=replace-me-run-openssl-rand-hex-32-to-generate-a-real-secret

# Optional. Default: 1h.
# Access token lifetime, as a `ms`-style duration (`15m`, `1h`, `7d`).
# Longer values widen the window in which a stolen token stays usable.
JWT_EXPIRES_IN=1h

# REQUIRED IN PRODUCTION. Boot fails in production with
# "CORS_ORIGINS is required in production" if missing or blank.
# Comma-separated list of exact browser origins allowed to make credentialed
# requests. No wildcards — this is a credentialed CORS policy, so `*` is not an
# option. Outside production an empty value permits all origins (dev only).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# =============================================================================
# Stellar / Soroban
# =============================================================================

# Optional. Default: testnet. Allowed: `testnet` or `mainnet` (exactly).
# Boot fails on any other value. Pointing a mainnet contract at testnet (or the
# reverse) means every on-chain charge silently targets the wrong ledger.
STELLAR_NETWORK=testnet

# Optional. Default: https://soroban-testnet.stellar.org
# Soroban RPC endpoint. MUST correspond to STELLAR_NETWORK — this is not
# cross-checked at boot, so a testnet RPC with STELLAR_NETWORK=mainnet fails
# only at charge time, mid-billing-run.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# REQUIRED when BILLING_ENABLED is not `false`.
# Address of the deployed SS-Billing Soroban contract. Must be a valid contract
# address (starts with `C`, 56 chars) — boot fails with "CONTRACT_ID is not a
# valid contract address" otherwise. A wrong-but-valid address sends charges to
# a contract that is not yours.
# The value below is an obvious placeholder and will NOT pass validation.
CONTRACT_ID=CREPLACEMEWITHYOURDEPLOYEDCONTRACTADDRESS0000000000000000

# REQUIRED when BILLING_ENABLED is not `false`.
# The billing keeper's Stellar SECRET SEED (starts with `S`, 56 chars). Must be
# a valid ed25519 secret seed — boot fails otherwise. The validator deliberately
# never echoes this value into an error message.
#
# !! THIS IS A LIVE SPENDING CREDENTIAL. !!
# Anyone holding it controls the keeper account and can drain it and submit
# arbitrary transactions on its behalf. In production it MUST come from a secret
# manager (AWS Secrets Manager, GCP Secret Manager, Vault, Kubernetes Secret
# injected at runtime) and be delivered as an in-memory environment variable —
# never from a `.env` file on disk, never in an image layer, never in CI logs.
# Use a dedicated, minimally-funded account, and rotate it on any suspicion.
# The value below is an obvious placeholder and will NOT pass validation.
SIGNER_SECRET=SREPLACEMEWITHTHEKEEPERSTELLARSECRETSEED0000000000000000

# Optional. Default: true (any value other than the literal `false`,
# case-insensitive, counts as enabled).
# Controls whether the on-chain billing keeper runs IN THIS PROCESS.
#
# EXACTLY ONE process must have billing enabled. Running the keeper in multiple
# API replicas double-charges subscribers. Set `BILLING_ENABLED=false` on every
# additional replica: those processes still serve the full read/write API, and
# CONTRACT_ID / SIGNER_SECRET are then neither required nor needed — which also
# means extra replicas never have to hold the spending key.
BILLING_ENABLED=true


# =============================================================================
# Redis
# =============================================================================

# Optional. Default: redis://localhost:6379
# Registered as configuration but not currently consumed by any module; present
# for forthcoming cache/queue work. Safe to leave at the default today.
REDIS_URL=redis://localhost:6379


# =============================================================================
# Webhooks
# =============================================================================

# Optional. Default: false. Enabled ONLY by the exact string `true`.
#
# !! THIS IS AN SSRF KILL SWITCH — `true` DISABLES A SECURITY CONTROL. !!
# Webhook target URLs are merchant-supplied. With this off, delivery to private
# address ranges is blocked. With it on, a merchant can register a webhook
# pointing at 127.0.0.1, 10.0.0.0/8, or the cloud metadata endpoint
# 169.254.169.254 and turn this service into an SSRF proxy into your own
# infrastructure — up to and including credential theft.
# Set to `true` ONLY on a local development machine. Never in staging or
# production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Optional. Default: 5000 (milliseconds).
# Per-attempt HTTP timeout for webhook delivery. Too high and slow merchant
# endpoints tie up delivery workers; too low and healthy endpoints are marked
# failed and retried unnecessarily.
WEBHOOK_TIMEOUT_MS=5000

# Optional. Default: 5.
# Maximum delivery attempts before a webhook is abandoned. Raising it increases
# duplicate-delivery pressure on merchant endpoints; merchants must treat
# webhooks as at-least-once regardless.
WEBHOOK_MAX_ATTEMPTS=5
